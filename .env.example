# Copiá este archivo como .env y completá los valores.
# NUNCA subas el .env a git (ya está en .gitignore).

# Access Token de PRUEBA de tu aplicación Checkout Pro
# (Mercado Pago Developers > Tus integraciones > tu app > Credenciales de prueba)
# Importante: usá el access token de la cuenta de prueba VENDEDORA.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# URL pública donde corre el servidor (ngrok, Render, etc.). Sin barra final.
# Mercado Pago la usa para back_urls y para el webhook (notification_url).
BASE_URL=https://tu-subdominio.ngrok-free.app

# Puerto local
PORT=3000

# Integrator ID: lo da Mercado Pago al ingresar al Partners Program.
# Si los criterios de la certificación lo piden, completalo. Si no, dejalo vacío.
MP_INTEGRATOR_ID=

# Clave secreta del webhook (Tus integraciones > Webhooks > "Clave secreta").
# Si la completás, el servidor valida la firma x-signature de cada notificación.
MP_WEBHOOK_SECRET=

# Email del comprador de PRUEBA (usuario de prueba comprador)
TEST_PAYER_EMAIL=test_user_comprador@testuser.com
